# ===== SGR Novels / SGR Class AI (Claude via apiclaude.cc) =====
# 비밀키 — 이 파일(.env)은 .gitignore 에 의해 커밋되지 않습니다.
# 실제 값은 이 템플릿을 복사한 .env 에만 기입하세요.
#
# 1) 로컬에서 엣지 함수 실행 시: 이 파일을 .env 로 복사하고 값을 채운 뒤
#    supabase/.env (또는 supabase functions serve --env-file) 로 로드
# 2) 프로덕션 배포 시:
#    supabase secrets set CLAUDE_API_KEY=sk-xxxx CLAUDE_API_URL=https://apiclaude.cc/v1/chat/completions CLAUDE_MODEL=claude-sonnet-5

# apiclaude.cc 채팅 completions 엔드포인트 (경로 포함)
CLAUDE_API_URL=https://apiclaude.cc/v1/chat/completions

# apiclaude.cc 에서 발급받은 비밀키 (절대 Git 에 커밋 금지)
CLAUDE_API_KEY=

# 사용할 모델명
CLAUDE_MODEL=claude-sonnet-5
